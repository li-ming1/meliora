+
+    /// Regression: dropping a page's last tile while the frame is still being
+    /// painted must keep the page sampleable. The paint pass records sprites
+    /// into the frame's primitive list *before* the platform draw resolves
+    /// them, and `Window::drop_image` can run in between (e.g. an LRU
+    /// `ImageCache::load` evicting during `img`'s paint). With the conditional
+    /// restore, an unreferenced page leaves a None slot and `texture()`
+    /// unwraps it — panicking mid-draw (crash seen in a real app, 2026-09-08).
+    /// The slot must stay occupied until the page is recycled via `free_list`.
+    #[test]
+    fn test_texture_view_survives_removing_the_pages_last_tile() {
+        let Some(atlas) = create_atlas() else {
+            return;
+        };
+
+        let key = make_image_key(1);
+        let tile = insert_tile(
+            &atlas,
+            &key,
+            Size {
+                width: DevicePixels(64),
+                height: DevicePixels(64),
+            },
+        );
+        let texture_id = tile.texture_id;
+
+        // The frame's already-recorded sprite still points at this page.
+        atlas.remove(&key);
+
+        // Must not panic: the pending sprite is resolved during this draw.
+        let _view = atlas.get_texture_view(texture_id);
+    }
 }
